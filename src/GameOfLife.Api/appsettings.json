{
  "GameOfLife": {
    "MaxWidth": 256,
    "MaxHeight": 256,
    "MaxSteps": 10000,
    "DefaultEdgeMode": "Dead"
  },
  "Storage": {
    "Path": "data/boards",
    "MaxSizeBytes": 1073741824,
    "CacheSizeLimitBytes": 67108864
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
